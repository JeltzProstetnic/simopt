<Project Sdk="Microsoft.NET.Sdk">
  <!-- SIM-129: speed per event. `dotnet run -c Release` prints time, allocation and a results
       fingerprint per case; the fingerprints are pinned by EngineFingerprintTests, so a speed-up
       that moves a single result fails the suite. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/SimOpt.Basics/SimOpt.Basics.csproj" />
    <ProjectReference Include="../../src/SimOpt.Mathematics/SimOpt.Mathematics.csproj" />
    <ProjectReference Include="../../src/SimOpt.Simulation/SimOpt.Simulation.csproj" />
  </ItemGroup>
</Project>
